APP_NAME=API
APP_ENV=local
APP_KEY=
# Keep false in production; enable locally when debugging.
APP_DEBUG=false
APP_URL=http://localhost
FRONTEND_URL=
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=lara_api_db
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=array
# ── Default Admin User (Seed) ─────────────────────────────────────────────────
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=password

# ── Session & Storage ─────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS S3 / Object Storage (Optional for Media) ──────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── API Core & Documentation ──────────────────────────────────────────────────
API_VERSION=v1
AUTH_GUARD=sanctum
DOCS_ACCESS_KEY=
SCALAR_CDN=https://cdn.jsdelivr.net/npm/@scalar/api-reference
SCALAR_API_URL=/docs/api.json

# ── Boost AI Assistant (Dev only) ─────────────────────────────────────────────
BOOST_ENABLED=true
BOOST_BROWSER_LOGS_WATCHER=true
DOCS_ACCESS_KEY=



AUTH_GUARD=sanctum


API_VERSION=V1
DOCS_ACCESS_KEY=lara-api-starter-secret
SCALAR_CDN=https://cdn.jsdelivr.net/npm/@scalar/api-reference
SCALAR_API_URL=/docs/api.json

# ── OAuth / Social Login (Module: social-login) ────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_API=60
RATE_LIMIT_AUTH=10
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=10
RATE_LIMIT_PASSWORD_RESET=3

# ── Request Security ──────────────────────────────────────────────────────────
REQUEST_MAX_SIZE_KB=0

# ── Pagination ────────────────────────────────────────────────────────────────
PAGINATION_PER_PAGE=15
PAGINATION_MAX_PER_PAGE=100