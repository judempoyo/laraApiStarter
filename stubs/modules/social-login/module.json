    },
    "patches": [
        {
            "type": "user-trait",
            "trait": "App\\Models\\Concerns\\HasSocialLogin"
        }
    ],
    "provider": "App\\Providers\\Modules\\SocialLoginServiceProvider",
    "ai": {
        "guidelines": [
            "ai/guidelines/social-login.md"
        ],
        "skills": []
    }
