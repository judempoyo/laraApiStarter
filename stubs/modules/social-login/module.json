        "app/Http/Controllers/Api/Auth/SocialiteController.php": "app/Http/Controllers/Api/Auth/SocialiteController.php",
        "app/Models/Concerns/HasSocialLogin.php": "app/Models/Concerns/HasSocialLogin.php",
        "app/Providers/Modules/SocialLoginServiceProvider.php": "app/Providers/Modules/SocialLoginServiceProvider.php",
        "config/social-login.php": "config/social-login.php",
        "database/migrations/2026_07_08_000001_add_social_and_avatar_to_users_table.php": "database/migrations/2026_07_08_000001_add_social_and_avatar_to_users_table.php",
        "routes/api/modules/social-login.php": "routes/api/modules/social-login.php",
        "ai/guidelines/social-login.md": ".ai/guidelines/modules/social-login.md",
        "tests/Feature/Auth/SocialiteLoginActionTest.php": "tests/Feature/Auth/SocialiteLoginActionTest.php"
    },
    "migrations": [
        "database/migrations/2026_07_08_000001_add_social_and_avatar_to_users_table.php"
